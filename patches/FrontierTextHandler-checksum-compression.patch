+def ecd_filename_checksum(payload_crc32: int, filename: str) -> int:
+    """Compute ECD header bytes 6-7 for an ASCII client filename.
+
+    The client uses uppercase basename including extension, seeds its raw CRC
+    state from the payload CRC, then takes bits 7-22. Authority: the installed
+    mhfo.dll validator at preferred VA 0x115686c0, compare at 0x1156879d.
+    Both Windows and POSIX paths are accepted; directory names are excluded.
+    """
+    if not isinstance(filename, str) or '\x00' in filename:
+        raise CryptoError('ECD filename must be text without NUL bytes')
+    name = ntpath.basename(filename)
+    if name in {'', '.', '..'}:
+        raise CryptoError('ECD filename must include a basename')
+    try:
+        normalized = name.encode('ascii').upper()
+    except UnicodeEncodeError as exc:
+        raise CryptoError('ECD filename must be ASCII') from exc
+    if not 0 <= payload_crc32 <= 0xffffffff:
+        raise CryptoError('ECD payload CRC must be an unsigned 32-bit value')
+    state = zlib.crc32(normalized, payload_crc32 ^ 0xffffffff) ^ 0xffffffff
+    return (state >> 7) & 0xffff
+
